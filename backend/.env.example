# Copy this file to ".env" (same folder as server.js) and fill in real values.
# Never commit ".env" to Git.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=your_supported_model_name_here
# Optional: use a compatible proxy or local test server instead of OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1
PORT=3000
