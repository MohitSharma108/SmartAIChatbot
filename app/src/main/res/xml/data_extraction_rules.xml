<?xml version="1.0" encoding="utf-8"?>
<!-- Chat history is local application data and should not be copied to cloud backup
     or transferred to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
